# Database — NOT set here. D1 is a binding (see wrangler.jsonc), not a
# connection string. Prisma reads it via getCloudflareContext() at runtime
# (src/lib/db.ts). The DATABASE_URL below is only a placeholder Prisma's
# schema loader wants to see at generate-time; it's unused at runtime.
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (magic-link email, HTTP API — https://resend.com/api-keys)
# SMTP won't work: Cloudflare Workers blocks raw outbound SMTP by default.
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# OpenRouter (multi-model AI gateway) — https://openrouter.ai/keys
# Free-tier models need a key too (still $0), just no billing required.
OPENROUTER_API_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sentry (error tracking) — https://sentry.io/settings/projects/keys/
# DSN is an ingestion endpoint ID, not a secret. Leave unset locally to
# disable Sentry entirely (init is a no-op without a DSN). SENTRY_AUTH_TOKEN
# (CI-only, for sourcemap uploads) IS a real credential — CI env config only,
# never commit it.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_ORG=""
SENTRY_PROJECT=""
# CI-only (sourcemap uploads): SENTRY_AUTH_TOKEN
